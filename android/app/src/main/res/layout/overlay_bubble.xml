<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/overlay_bubble"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_overlay_bubble"
        android:gravity="center"
        android:text="MP"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:elevation="8dp" />

    <LinearLayout
        android:id="@+id/overlay_panel"
        android:layout_width="216dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_overlay_panel"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MAX PERFORMANCE"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/overlay_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="FPS alvo 90 · Boost ON"
            android:textColor="#FF9B9B"
            android:textSize="10sp" />

        <Button
            android:id="@+id/overlay_btn_fps"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="@drawable/bg_overlay_button"
            android:text="FPS Alvo: 90"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <Button
            android:id="@+id/overlay_btn_slow"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_overlay_button"
            android:text="Boneco Lento: OFF"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <Button
            android:id="@+id/overlay_btn_economy"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_overlay_button"
            android:text="Modo Economia: OFF"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <Button
            android:id="@+id/overlay_btn_boost"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_overlay_button"
            android:text="Boost: ON"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <Button
            android:id="@+id/overlay_btn_close"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_overlay_close"
            android:text="Fechar Bolinha"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
